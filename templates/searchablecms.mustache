{{!
@template format_mtubebs/searchablecms
Searchable list of course module links.
Example context (json):
{
}
}}
<ul id="search-results">
    {{#cms}}
    <li class="activity search-result border-bottom px-3 py-2 d-none"
        data-type="{{modname}}"
        data-name="{{{name}}}"
        data-tagids="{{tagids}}"
        data-competencyids="{{competencyids}}"
        data-outcomeids="{{outcomeids}}">
        <div class="search-result-icon">{{{icon}}}</div>
        <div class="d-flex flex-column">
        <{{#visible}}a{{/visible}}{{^visible}}span{{/visible}} href="{{{url}}}" class="search-result-link d-flex align-items-start">
        <div class="search-result-title line-height-3 iv-font-weight-bold">{{{name}}}</div>
        </{{#visible}}a{{/visible}}{{^visible}}span{{/visible}}>
        {{#sectionname}}
        <div class="search-result-section small text-muted cursor-pointer" data-id="{{sectionnum}}">{{{sectionname}}}</div>
        {{/sectionname}}
        </div>
    </li>
{{/cms}}
</ul>
