{{!
@template format_mtubebs/backgroundloading
Loading placeholder shown while async content loads.
Example context (json):
{
}
}}
<div class="position-absolute w-100 h-100 bg-body left-0 top-0"
     id="background-loading">
    <div class="d-flex h-100 align-items-center justify-content-center">
        <div class="spinner-border text-danger"
             role="status">
            <span class="visually-hidden">{{#str}}loading, admin{{/str}}</span>
        </div>
    </div>
</div>
