{{!
    @template format_mtubebs/coursecontact

    Course contact and teacher information block.

    Example context (json):
    {
    }
}}

<div class="w-100 course-contacts mt-1">
{{#contactdata}}
    <div class="coursecontact-item mb-3 me-3 d-flex align-items-center w-100">
        {{{profile}}}
        <div class="d-inline-block align-middle ms-1">
        <div class="d-flex flex-column">
        <a class="iv-font-weight-bold"
           href="{{url}}"
           style="line-height:1;">{{{name}}}</a>
        {{#description}}
        <span class="small text-muted">{{description}}</span>
        {{/description}}
        {{^description}}
        {{^isguestuser}}
        <a class="small text-muted text-decoration-none" href="mailto:{{email}}" target="_blank">{{email}}</a>
        {{/isguestuser}}
        {{/description}}
        </div>
        </div>
    </div>
{{/contactdata}}
</div>