{{!
@template format_mtubebs/sectionhead
Section header with title, summary, and actions.
Example context (json):
{
}
}}
<div class="sectionheader-card card d-flex flex-column justify-content-between position-relative border-0 mb-2 mt-2 {{#current}}current{{/current}} bg-body rounded-0 shadow-none" role="presentation">
    <div class="card-body p-0 d-flex">
        {{#current}}
            <span class="iv-badge-primary position-absolute badge-current">{{currentsectionlabel}}</span>
        {{/current}}
        <div class="position-relative rounded-xl w-100 overflow-hidden">
            <div class="background-image-cover h-100 position-absolute top-0 start-0 w-100 z-index-1"></div>
            <div class="section-image"></div>
            <div class="h3 position-relative z-index-1 m-3 d-flex">
                {{#showsectionnumber}}
                    <span class="h1 opacity-50 me-3 mb-0">{{section}}</span>
                {{/showsectionnumber}}
                <div class="iv-font-weight-bold line-height-15">{{{name}}}</div>
            </div>
            {{^visible}}<i class="section-invisible fa fa-eye-slash ms-1" aria-hidden="true"></i>{{/visible}}
        </div>
    </div>
</div>
