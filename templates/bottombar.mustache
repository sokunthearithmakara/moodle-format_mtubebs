{{!
@template format_mtubebs/bottombar
Mobile bottom navigation bar for sections and course tools.
Example context (json):
{
}
}}
<div id="bottombar-wrapper" class="w-100">
    <div id="bottombar"
         class="d-flex align-items-center p-2 w-100 justify-content-around">
        {{^options.hideresize}}
        <div class="expand-toggle-wrapper">
            <button id="expand-toggle"
                    type="button"
                    class="btn-icon icons-collapse-expand btn mx-1 mb-1"
                    title="{{#str}}resize, format_mtubebs{{/str}}"
                    aria-label="{{#str}}resize, format_mtubebs{{/str}}">
                <i class="fa fa-expand-alt" aria-hidden="true"></i>
                <i class="fa fa-compress-alt" aria-hidden="true"></i>
            </button>
            <span class="small text-muted mb-0">{{#str}}resize, format_mtubebs{{/str}}</span>
        </div>
        {{/options.hideresize}}
        {{^options.hidemenu}}
        <div id="secondarymenu-toggle-wrapper">
            <button type="button"
                    class="btn-icon icons-collapse-expand btn mx-1 mb-1"
                    id="secondarymenu-toggle"
                    aria-expanded="false"
                    title="{{#str}}togglesidebar, format_mtubebs{{/str}}"
                    aria-label="{{#str}}togglesidebar, format_mtubebs{{/str}}">
                <i class="fa fa-bars" aria-hidden="true"></i>
            </button>
            <span class="small text-muted mb-0">{{#str}}togglesidebar, format_mtubebs{{/str}}</span>
        </div>
        {{/options.hidemenu}}
        <div>
            <button type="button"
                    id="sideinfo-toggle"
                    class="btn-icon icons-collapse-expand btn mx-1 mb-1"
                    aria-expanded="false"
                    title="{{#str}}courseinfo, format_mtubebs{{/str}}"
                    aria-label="{{#str}}info, format_mtubebs{{/str}}">
                <i class="fa fa-chalkboard-user" aria-hidden="true"></i>
            </button>
            <span class="small text-muted mb-0">{{#str}}info, format_mtubebs{{/str}}</span>
        </div>
        {{! More }}
        <div class="position-relative" id="more-menu-wrapper">
            <div id="more-menu">
                {{#options.shownews}}
                <a href="{{newsurl}}"
                   class="d-flex align-items-center w-100 text-decoration-none cursor-pointer">
                    <button class="btn-icon icons-collapse-expand btn mx-1 mb-1"
                            role="button"
                            title="{{#str}}news, format_mtubebs{{/str}}">
                        <i class="fa fa-newspaper" aria-hidden="true"></i>
                    </button>
                    <span class="small text-muted mb-0 ms-1">{{#str}}news, format_mtubebs{{/str}}</span>
                </a>
            {{/options.shownews}}
            {{#options.showgradenav}}
            {{#canedit}}
            <a href="{{wwwroot}}/grade/report/grader/index.php?id={{course.id}}"
               class="d-flex align-items-center w-100 text-decoration-none cursor-pointer">
                <button class="btn-icon icons-collapse-expand btn mx-1 mb-1"
                        role="button"
                        title="{{#str}}grade, format_mtubebs{{/str}}">
                    <i class="fa fa-bar-chart" aria-hidden="true"></i>
                </button>
                <span class="small text-muted mb-0 ms-1">{{#str}}grade, format_mtubebs{{/str}}</span>
            </a>
        {{/canedit}}
        {{^canedit}}
        <span id="grade-toggle"
              class="d-flex align-items-center w-100 text-decoration-none cursor-pointer"
              data-url="{{wwwroot}}/grade/report/user/index.php?id={{course.id}}">
            <button class="btn-icon icons-collapse-expand btn mx-1 mb-1"
                    role="button"
                    title="{{#str}}grade, format_mtubebs{{/str}}">
                <i class="fa fa-bar-chart" aria-hidden="true"></i>
            </button>
            <span class="small text-muted mb-0 ms-1">{{#str}}grade, format_mtubebs{{/str}}</span>
        </span>
    {{/canedit}}
{{/options.showgradenav}}
{{#options.showtimeline}}
<span id="timeline-toggle"
      class="d-flex align-items-center w-100 text-decoration-none cursor-pointer">
    <button class="btn-icon icons-collapse-expand btn mx-1 mb-1"
            title="{{#str}}deadline, format_mtubebs{{/str}}">
        <i class="fa fa-clock" aria-hidden="true"></i>
    </button>
    <span class="small text-muted mb-0 ms-1">{{#str}}deadline, format_mtubebs{{/str}}</span>
</span>
{{/options.showtimeline}}
{{#options.showbadge}}
<a id="badge-toggle"
   class="d-flex align-items-center w-100 text-decoration-none cursor-pointer"
   href="{{wwwroot}}/badges/index.php?id={{course.id}}&type=2">
    <button class="btn-icon icons-collapse-expand btn mx-1 mb-1"
            title="{{#str}}badge, format_mtubebs{{/str}}">
        <i class="fa fa-medal" aria-hidden="true"></i>
    </button>
    <span class="small text-muted mb-0 ms-1">{{#str}}badge, format_mtubebs{{/str}}</span>
</a>
{{/options.showbadge}}
{{#options.showcompletion}}
{{#canedit}}
<a id="completion-toggle"
   class="d-flex align-items-center w-100 text-decoration-none cursor-pointer"
   href="{{wwwroot}}/report/completion/index.php?id={{course.id}}">
    <button class="btn-icon icons-collapse-expand btn mx-1 mb-1"
            title="{{#str}}progress, format_mtubebs{{/str}}">
        <i class="fa fa-check-circle" aria-hidden="true"></i>
    </button>
    <span class="small text-muted mb-0 ms-1">{{#str}}progress, format_mtubebs{{/str}}</span>
</a>
{{/canedit}}
{{^canedit}}
<span id="completion-toggle"
      class="d-flex align-items-center w-100 text-decoration-none cursor-pointer"
      data-url="{{wwwroot}}/blocks/completionstatus/details.php?course={{course.id}}&user={{user.id}}">
    <button class="btn-icon icons-collapse-expand btn mx-1 mb-1"
            title="{{#str}}progress, format_mtubebs{{/str}}">
        <i class="fa fa-check-circle" aria-hidden="true"></i>
    </button>
    <span class="small text-muted mb-0 ms-1">{{#str}}progress, format_mtubebs{{/str}}</span>
</span>
{{/canedit}}
{{/options.showcompletion}}
{{#options.links}}
<a href="{{url}}"
   class="d-flex align-items-center w-100 text-decoration-none cursor-pointer"
   target="_blank"
   rel="noopener">
    <button class="btn-icon icons-collapse-expand btn mx-1 mb-1">
        {{#icon}}
        <i class="{{icon}}" aria-hidden="true"></i>
    {{/icon}}
    {{^icon}}
    <i class="fa fa-external-link" aria-hidden="true"></i>
{{/icon}}
</button>
{{#label}}
<span class="small text-muted mb-0 ms-1">{{label}}</span>
{{/label}}
</a>
{{/options.links}}
</div>
<button type="button"
        id="more-toggle"
        class="btn-icon icons-collapse-expand btn mx-1 mb-1"
        aria-expanded="false"
        title="{{#str}}more, format_mtubebs{{/str}}"
        aria-label="{{#str}}more, format_mtubebs{{/str}}">
    <i class="fa fa-ellipsis-h" aria-hidden="true"></i>
</button>
<span class="small text-muted mb-0">{{#str}}more, format_mtubebs{{/str}}</span>
</div>
{{#isroleswitched}}
{{#switchroleurl}}
<div>
    <a href="{{switchroleurl}}"
       id="switchrole-toggle"
       class="active btn-icon icons-collapse-expand btn mx-1 mb-1"
       title="{{#str}}studentview, format_mtubebs{{/str}}"
       aria-label="{{#str}}studentview, format_mtubebs{{/str}}">
        <i class="fa fa-user-circle" aria-hidden="true"></i>
    </a>
    <span class="small text-muted mb-0">{{#str}}studentview, format_mtubebs{{/str}}</span>
</div>
{{/switchroleurl}}
{{/isroleswitched}}
{{^isroleswitched}}
{{#canedit}}
{{#switchroleurl}}
<div>
    <a href="{{switchroleurl}}"
       id="switchrole-toggle"
       class="btn-icon icons-collapse-expand btn mx-1 mb-1"
       title="{{#str}}studentview, format_mtubebs{{/str}}"
       aria-label="{{#str}}studentview, format_mtubebs{{/str}}">
        <i class="fa fa-user-circle" aria-hidden="true"></i>
    </a>
    <span class="small text-muted mb-0">{{#str}}studentview, format_mtubebs{{/str}}</span>
</div>
{{/switchroleurl}}
{{/canedit}}
{{/isroleswitched}}
</div>
</div>
