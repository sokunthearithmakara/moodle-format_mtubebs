{{!
    @template format_mtubebs/local/content/cm/availability

    Displays a activity availability.

    Example context (json):
    {
        "info": [
            {
                "classes": "",
                "text": "Not available unless: <ul><li>It is on or after <strong>8 June 2012</strong></li></ul>",
                "ishidden": 0,
                "isstealth": 0,
                "isrestricted": 1,
                "isfullinfo": 1
            }
        ],
        "hasmodavailability": true
    }
}}
{{#hasmodavailability}}
    {{#info}}
        {{^isrestricted}}
            <span class="badge rounded-pill bg-warning text-dark">{{{text}}}</span>
        {{/isrestricted}}
        {{#isrestricted}}
            <button
                class="btn p-0 me-1 bg-transparent border-0 activity-restriction"
                type="button"
                tabindex="0"
                data-bs-container="body"
                data-bs-toggle="popover"
                data-bs-placement="top"
                data-bs-html="true"
                aria-label="{{#str}}aria:availabilityrestriction, format_mtubebs{{/str}}"
                data-bs-content='{{{text}}}'
                data-bs-trigger="focus"><span class="visually-hidden">{{#str}}aria:availabilityrestriction, format_mtubebs{{/str}}</span>
                <i class="fa fa-lock fa-fw" aria-hidden="true"></i></button>
        {{/isrestricted}}
    {{/info}}
{{/hasmodavailability}}
