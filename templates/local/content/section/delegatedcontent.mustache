{{!
@template format_mtubebs/local/content/section/delegatedcontent
The internal content of a section.
Example context (json):
{
"num": 3,
"id": 35,
"controlmenu": "[tools menu]",
"header": {
"name": "Section title",
"title": "<a href=\"http://moodle/course/view.php?id=5#section-0\">Section title</a>",
"url": "#",
"ishidden": true,
"headinglevel": 3
},
"cmlist": {
"cms": [
{
"cmitem": {
"cmformat": {
"cmname": "<a class=\"aalink\" href=\"#\"><span class=\"instancename\">Forum example</span></a>",
"hasname": "true"
},
"id": 3,
"cmid": 3,
"module": "forum",
"anchor": "activity-3",
"extraclasses": "newmessages"
}
},
{
"cmitem": {
"cmformat": {
"cmname": "<a class=\"aalink\" href=\"#\"><span class=\"instancename\">Assign example</span></a>",
"hasname": "true"
},
"id": 4,
"cmid": 4,
"anchor": "activity-4",
"module": "assign",
"extraclasses": ""
}
}
],
"hascms": true
},
"ishidden": false,
"iscurrent": true,
"currentlink": "<span class=\"accesshide\">This topic</span>",
"availability": {
"info": "<span class=\"badge bg-info\">Hidden from students</span>",
"hasavailability": true
},
"summary": {
"summarytext": "Summary text!"
},
"controlmenu": {
"menu": "<a href=\"#\" class=\"d-inline-block dropdown-toggle icon-no-margin\">Edit<b class=\"caret\"></b></a>",
"hasmenu": true
},
"iscoursedisplaymultipage": true,
"sectionreturnnum": 0,
"contentcollapsed": false,
"insertafter": true,
"numsections": 42,
"sitehome": false,
"isstealth": false,
"highlightedlabel" : "Highlighted"
}
}}
<div class="course-section-header d-flex mx-2 bg-transparent"
     data-for="section_title"
     data-id="{{id}}"
     data-number="{{num}}">
    {{#header}}
    {{^preventcollapsing}}
    {{$ format_mtubebs/local/content/section/delegatedheader }}
        {{> format_mtubebs/local/content/section/delegatedheader }}
    {{/ format_mtubebs/local/content/section/delegatedheader }}
    {{/preventcollapsing}}
    {{#preventcollapsing}}
    <h4 class="sectionname course-content-item d-flex align-self-stretch text-dark align-items-center mb-0"
            id="sectionid-{{id}}-title"
            data-for="section_title"
            data-id="{{id}}"
            data-number="{{num}}">{{{name}}}</h4>
    {{/preventcollapsing}}
        {{/header}}
{{^singleheader}}
{{#restrictionlock}}
<div class="align-self-center ms-2">{{#pix}}t/unlock, core{{/pix}}</div>
{{/restrictionlock}}
{{/singleheader}}
<div data-region="sectionbadges"
     class="sectionbadges d-flex align-items-center">
    {{$ core_courseformat/local/content/section/badges }}
    {{> core_courseformat/local/content/section/badges }}
{{/ core_courseformat/local/content/section/badges }}
</div>
</div>
<div id="coursecontentcollapseid{{id}}"
     class="content course-content-item-content {{^preventcollapsing}}collapse {{^contentcollapsed}}show{{/contentcollapsed}}{{/preventcollapsing}}{{#preventcollapsing}}show{{/preventcollapsing}} position-relative delegated px-3">
    <div class="{{#hasavailability}}description{{/hasavailability}} px-3 py-0"
         data-for="sectioninfo">
        {{#isstealth}}
        <div class="alert alert-warning">{{#str}}orphansectionwarning, core_courseformat {{/str}}</div>
    {{/isstealth}}
    {{#summary}}
    {{$ core_courseformat/local/content/section/summary }}
    {{> core_courseformat/local/content/section/summary }}
{{/ core_courseformat/local/content/section/summary }}
{{/summary}}
{{#availability}}
{{$ core_courseformat/local/content/section/availability }}
{{> core_courseformat/local/content/section/availability }}
{{/ core_courseformat/local/content/section/availability }}
{{/availability}}
</div>
{{#cmlist}}
{{$ format_mtubebs/local/content/section/cmlist }}
{{> format_mtubebs/local/content/section/cmlist }}
{{/ format_mtubebs/local/content/section/cmlist }}
{{/cmlist}}
</div>
