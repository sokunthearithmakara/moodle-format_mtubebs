{{!
    @template format_mtubebs/local/content/section/cmlist

    Displays the course module list inside a course section.

    Example context (json):
    {
        "cms": [
            {
                "cmitem": {
                    "cmformat": {
                        "cmname": "<a class=\"aalink\" href=\"#\"><span class=\"instancename\">Forum example</span></a>",
                        "hasname": "true"
                    },
                    "id": 3,
                    "module": "forum",
                    "anchor": "module-3",
                    "extraclasses": "newmessages"
                }
            },
            {
                "cmitem": {
                    "cmformat": {
                        "cmname": "<a class=\"aalink\" href=\"#\"><span class=\"instancename\">Assign example</span></a>",
                        "hasname": "true"
                    },
                    "id": 4,
                    "module": "assign",
                    "anchor": "module-4",
                    "extraclasses": ""
                }
            }
        ],
        "hascms": true
    }
}}

{{#hascms}}
<ul class="section m-0 p-0 img-text d-flex flex-wrap" data-for="cmlist">
{{#cms}}
    {{#cmitem}}
        {{$ format_mtubebs/local/content/section/cmitem}}
            {{> format_mtubebs/local/content/section/cmitem}}
        {{/ format_mtubebs/local/content/section/cmitem}}
    {{/cmitem}}
{{/cms}}
</ul>
{{/hascms}}

