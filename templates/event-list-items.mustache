{{!
@template format_mtubebs/event-list-items
This template renders a group of event list items for the timeline block.
Example context (json):
{
    "events": [
        {
            "timesort": 1700000000,
            "icon": {
                "iconurl": "https://example.com/theme/image.php/boost/forum/1/monologo",
                "iconclass": "",
                "alttext": "Forum"
            },
            "overdue": false,
            "url": "https://example.com/mod/forum/view.php?id=3",
            "name": "Discussion due",
            "activityname": "Discussion due",
            "activitystr": "Forum"
        }
    ]
}
}}
<div class="list-group list-group-flush">
    {{#events}}
    {{> format_mtubebs/event-list-item }}
{{/events}}
</div>
