{{!
@template format_mtubebs/courseheader-v
Vertical course header banner.
Example context (json):
{
}
}}
<div class="d-flex align-items-start w-100 py-3 px-4 mx-auto position-relative overflow-hidden"
     id="header-v">
    {{#options.showcourseimage}}
    <div class="ratio ratio-16x9 me-3 rounded-3 overflow-hidden position-relative"
         style="min-width: 125px;
                width: 20%">
        <img id="course-image"
             src="{{course.image}}"
             alt="{{{course.coursetitle}}}"
             class="">
        {{#caneditimage}}
        <button type="button"
                class="btn btn-sm btn-light course-image-edit-btn position-absolute top-0 end-0 m-1 z-3"
                data-action="edit-course-image"
                title="{{#str}}editcourseimage, format_mtubebs{{/str}}">
            <i class="fa fa-pen" aria-hidden="true"></i>
            <span class="visually-hidden">{{#str}}editcourseimage, format_mtubebs{{/str}}</span>
        </button>
        {{/caneditimage}}
        {{#course.video}}
        <div class="video-wrapper position-absolute w-100 h-100 top-0 start-0 d-flex justify-content-center align-items-center"
             data-type="{{course.videotype}}"
             data-url="{{course.video}}">
            <i class="fa fa-play" aria-hidden="true"></i>
        </div>
    {{/course.video}}
</div>
{{/options.showcourseimage}}
<div class="flex-grow-1">
    <h5 class="title h5 iv-font-weight-bold mb-1 text-start clamp-3"
        title="{{{course.coursetitle}}}">{{{course.coursetitle}}}</h5>
</div>
{{#course.image}}
<img id="course-image-background"
     src="{{course.image}}"
     alt="{{{course.coursetitle}}}">
{{/course.image}}
<div class="title-background"></div>
<div class="bottom-background"></div>
{{#caneditsettings}}
<div>
    <button id="setting-toggle"
            name="formatoptions"
            data-origin="coursepage"
            class="btn-icon icons-collapse-expand btn mx-1 mb-1"
            type="button"
            title="{{#str}}format{{/str}}">
        <i class="fa fa-palette" aria-hidden="true"></i>
    </button>
</div>
{{/caneditsettings}}
</div>
