{{!
@template format_mtubebs/sidebar
Course sidebar navigation with sections and custom links.
Example context (json):
{
}
}}
<aside id="sidebar-wrapper"
     class="d-flex flex-column bg-body justify-content-between align-items-center {{#options.showlabels}}p-0{{/options.showlabels}} {{^options.showlabels}}hide-labels border-end pb-3{{/options.showlabels}}" aria-label="{{#str}}courseactions, format_mtubebs{{/str}}">
    <div class="d-flex flex-column bg-body align-items-center py-3 px-0 overflow-auto justify-content-start scrollbar-0">
        {{^options.hidemenu}}
        <div id="secondarymenu-toggle-wrapper">
            <button class="btn-icon icons-collapse-expand btn mx-1 mb-0"
                    type="button"
                    id="secondarymenu-toggle"
                    aria-expanded="false"
                    title="{{#str}}togglesidebar, format_mtubebs{{/str}}"
                    aria-label="{{#str}}togglesidebar, format_mtubebs{{/str}}">
                <i class="fa fa-bars" aria-hidden="true"></i>
            </button>
            <span class="small mb-2" {{^options.showlabels}}aria-hidden="true"{{/options.showlabels}}>{{#str}}togglesidebar, format_mtubebs{{/str}}</span>
        </div>
        {{/options.hidemenu}}
        <div>
            <button id="sideinfo-toggle"
                    type="button"
                    class="btn-icon icons-collapse-expand btn mx-1 mb-0"
                    aria-expanded="false"
                    title="{{#str}}info, format_mtubebs{{/str}}"
                    aria-label="{{#str}}info, format_mtubebs{{/str}}">
                <i class="fa fa-chalkboard-user" aria-hidden="true"></i>
            </button>
            <span class="small mb-2" {{^options.showlabels}}aria-hidden="true"{{/options.showlabels}}>{{#str}}info, format_mtubebs{{/str}}</span>
        </div>
        {{#options.shownews}}
        <div>
            <a href="{{newsurl}}"
               class="btn-icon icons-collapse-expand btn mx-1 mb-0"
               title="{{#str}}news, format_mtubebs{{/str}}"
               aria-label="{{#str}}news, format_mtubebs{{/str}}">
                <i class="fa fa-newspaper" aria-hidden="true"></i>
            </a>
            <span class="small mb-2" {{^options.showlabels}}aria-hidden="true"{{/options.showlabels}}>{{#str}}news, format_mtubebs{{/str}}</span>
        </div>
    {{/options.shownews}}
    {{#options.showgradenav}}
    <div>
        {{#canedit}}
        <a href="{{wwwroot}}/grade/report/grader/index.php?id={{course.id}}"
           class="btn-icon icons-collapse-expand btn mx-1 mb-0"
           title="{{#str}}grade, format_mtubebs{{/str}}"
           aria-label="{{#str}}grade, format_mtubebs{{/str}}">
            <i class="fa fa-bar-chart" aria-hidden="true"></i>
        </a>
    {{/canedit}}
    {{^canedit}}
    <button type="button"
            id="grade-toggle"
            data-url="{{wwwroot}}/grade/report/user/index.php?id={{course.id}}"
            title="{{#str}}grade, format_mtubebs{{/str}}"
            aria-label="{{#str}}grade, format_mtubebs{{/str}}"
            class="btn-icon icons-collapse-expand btn mx-1 mb-0">
        <i class="fa fa-bar-chart" aria-hidden="true"></i>
    </button>
{{/canedit}}
<span class="small mb-2" {{^options.showlabels}}aria-hidden="true"{{/options.showlabels}}>{{#str}}grade, format_mtubebs{{/str}}</span>
</div>
{{/options.showgradenav}}
{{#options.showtimeline}}
<div>
    <button type="button"
            id="timeline-toggle"
            class="btn-icon icons-collapse-expand btn mx-1 mb-0"
            title="{{#str}}deadline, format_mtubebs{{/str}}"
            aria-label="{{#str}}deadline, format_mtubebs{{/str}}">
        <i class="fa fa-clock" aria-hidden="true"></i>
    </button>
    <span class="small mb-2" {{^options.showlabels}}aria-hidden="true"{{/options.showlabels}}>{{#str}}deadline, format_mtubebs{{/str}}</span>
</div>
{{/options.showtimeline}}
{{#options.showbadge}}
<div>
    <a id="badge-toggle"
       href="{{wwwroot}}/badges/index.php?id={{course.id}}&type=2"
       title="{{#str}}badge, format_mtubebs{{/str}}"
       aria-label="{{#str}}badge, format_mtubebs{{/str}}"
       class="btn-icon icons-collapse-expand btn mx-1 mb-0">
        <i class="fa fa-medal" aria-hidden="true"></i>
    </a>
    <span class="small mb-2" {{^options.showlabels}}aria-hidden="true"{{/options.showlabels}}>{{#str}}badge, format_mtubebs{{/str}}</span>
</div>
{{/options.showbadge}}
{{#options.showcompletion}}
<div>
    {{#canedit}}
    <a href="{{wwwroot}}/report/completion/index.php?course={{course.id}}"
       class="btn-icon icons-collapse-expand btn mx-1 mb-0"
       title="{{#str}}progress, format_mtubebs{{/str}}"
       aria-label="{{#str}}progress, format_mtubebs{{/str}}">
        <i class="fa fa-check-circle" aria-hidden="true"></i>
    </a>
{{/canedit}}
{{^canedit}}
<button type="button"
        id="completion-toggle"
        data-url="{{wwwroot}}/blocks/completionstatus/details.php?course={{course.id}}&user={{user.id}}"
        title="{{#str}}progress, format_mtubebs{{/str}}"
        aria-label="{{#str}}progress, format_mtubebs{{/str}}"
        class="btn-icon icons-collapse-expand btn mx-1 mb-0">
    <i class="fa fa-check-circle" aria-hidden="true"></i>
</button>
{{/canedit}}
<span class="small mb-2" {{^options.showlabels}}aria-hidden="true"{{/options.showlabels}}>{{#str}}progress, format_mtubebs{{/str}}</span>
</div>
{{/options.showcompletion}}
{{#options.links}}
<div>
    <a href="{{{url}}}"
       class="btn-icon icons-collapse-expand btn mx-1 mb-0"
       target="_blank"
       title="{{label}}"
       aria-label="{{label}}"
       rel="noopener">
        {{#icon}}
        <i class="{{icon}}" aria-hidden="true"></i>
    {{/icon}}
</a>
{{#label}}
<span class="small mb-2" {{^options.showlabels}}aria-hidden="true"{{/options.showlabels}}>{{label}}</span>
{{/label}}
</div>
{{/options.links}}
</div>
<div class="d-flex flex-column bg-body align-items-center px-0 justify-content-end">
    {{#caneditsettings}}
    <div>
        <button type="button"
                id="setting-toggle"
                name="formatoptions"
                data-origin="coursepage"
                class="btn-icon icons-collapse-expand btn mx-1 mb-0"
                title="{{#str}}format{{/str}}">
            <i class="fa fa-palette" aria-hidden="true"></i>
        </button>
        <span class="small mb-2" aria-hidden="true">{{#str}}format{{/str}}</span>
    </div>
{{/caneditsettings}}
{{#isroleswitched}}
{{#switchroleurl}}
<div>
    <a href="{{switchroleurl}}"
       id="switchrole-toggle"
       class="active btn-icon icons-collapse-expand btn mx-1 mb-0"
       title="{{#str}}studentview, format_mtubebs{{/str}}"
       aria-label="{{#str}}studentview, format_mtubebs{{/str}}">
        <i class="fa fa-user-circle" aria-hidden="true"></i>
    </a>
    <span class="small mb-2" {{^options.showlabels}}aria-hidden="true"{{/options.showlabels}}>{{#str}}studentview, format_mtubebs{{/str}}</span>
</div>
{{/switchroleurl}}
{{/isroleswitched}}
{{^isroleswitched}}
{{#canedit}}
{{#switchroleurl}}
<div>
    <a href="{{switchroleurl}}"
       id="switchrole-toggle"
       class="btn-icon icons-collapse-expand btn mx-1 mb-0"
       title="{{#str}}studentview, format_mtubebs{{/str}}"
       aria-label="{{#str}}studentview, format_mtubebs{{/str}}">
        <i class="fa fa-user-circle" aria-hidden="true"></i>
    </a>
    <span class="small mb-2" {{^options.showlabels}}aria-hidden="true"{{/options.showlabels}}>{{#str}}studentview, format_mtubebs{{/str}}</span>
</div>
{{/switchroleurl}}
{{/canedit}}
{{/isroleswitched}}
{{^options.hideresize}}
<div class="expand-toggle-wrapper">
    <button type="button"
            id="expand-toggle"
            class="btn-icon icons-collapse-expand btn mx-1 mb-0"
            title="{{#str}}resize, format_mtubebs{{/str}}"
            aria-label="{{#str}}resize, format_mtubebs{{/str}}">
        <i class="fa fa-expand-alt" aria-hidden="true"></i>
        <i class="fa fa-compress-alt" aria-hidden="true"></i>
    </button>
    <span class="small mb-2" {{^options.showlabels}}aria-hidden="true"{{/options.showlabels}}>{{#str}}resize, format_mtubebs{{/str}}</span>
</div>
{{/options.hideresize}}
</div>
</aside>
